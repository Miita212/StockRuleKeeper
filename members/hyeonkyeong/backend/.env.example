# 이 파일을 .env 로 복사해 값을 채운다. .env 는 공유·업로드 금지.
# 한투 키는 실전 계좌 키이므로 external/kis/client.py 의 허용 목록(조회 API만)을 넓히지 말 것.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=real
DART_API_KEY=
ANTHROPIC_API_KEY=

# live 또는 fixture (fixture: external/fixtures 의 가짜 샘플로 동작, 키 불필요)
EXTERNAL_MODE=live
# 원칙 변환(FR-01)용. anthropic 또는 local. 종합 리포트는 항상 Anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
