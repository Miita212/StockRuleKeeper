# 이 파일을 .env 로 복사해 값을 채운다. .env 는 공유·업로드 금지.
# 한투 키는 실전 계좌 키이므로 external/kis/client.py 의 허용 목록(조회 API만)을 넓히지 말 것.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ENV=real
DART_API_KEY=
ANTHROPIC_API_KEY=

# live 또는 fixture (fixture: external/fixtures 의 가짜 샘플로 동작, 키 불필요)
EXTERNAL_MODE=live
# 원칙 변환(FR-01)용. anthropic 또는 local. 종합 리포트는 항상 Anthropic
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=local 일 때: Ollama 주소와 파인튜닝 Qwen3-8B 모델 이름
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3-8b-stockrule
# 시연(로컬 모델)용: 위 LLM_PROVIDER 를 local 로 바꾸고 아래 타임아웃도 켠다.
# 로컬 원칙 변환이 13~18초(RTX 4060)라 기본 20초면 끊길 수 있다.
# HTTP_TIMEOUT=300
